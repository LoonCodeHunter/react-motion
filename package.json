  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:es": "tsc -p tsconfig.es.json && node scripts/copy-css.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "npm run clean && npm run build:es && npm run build:types && node scripts/verify.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run pack:dry",
    "pack:dry": "npm pack --dry-run --ignore-scripts",
    "prepack": "npm run check",
    "pack:verify": "node scripts/verify.mjs",
    "security": "npm audit --audit-level=high",
    "release:check": "npm run verify:lockfile && npm run badges:check && npm run docs:check && npm run check && npm run pack:verify",
    "verify:lockfile": "node scripts/verify-package-lock.mjs",
    "docs:check": "node scripts/verify-docs.mjs",
    "badges:check": "node scripts/verify-badges.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:release": "npm run typecheck && npm test && npm run docs:check && npm run badges:check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.18.11",
    "typescript": "^6.0.2"
  }
